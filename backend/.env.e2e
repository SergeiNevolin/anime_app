# Configuration of the API used by the end to end tests.
#
# The deterministic `fixture` provider is enabled, so the scenarios never
# depend on the availability of an external anime site.
APP_ENV=test
LOG_LEVEL=WARNING

DATABASE_URL=postgresql+asyncpg://anime:anime@localhost:5432/anime
REDIS_URL=redis://localhost:6379/0

ALLOWED_PROVIDERS=fixture
DEV_AUTH_ENABLED=true
DEV_AUTH_TELEGRAM_ID=777000

CORS_ORIGINS=http://127.0.0.1:3100,http://localhost:3000,http://127.0.0.1:3000
